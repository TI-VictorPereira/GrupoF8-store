# Rascunho, não wired. Renomear para deploy-vercel.yml quando os secrets
# abaixo existirem no repositório (Settings → Secrets and variables → Actions)
# e a Vercel CLI tiver sido testada localmente com `vercel dev` — este
# workflow nunca foi executado, é o desenho da ordem que precisa valer.
#
# A ordem que importa: migration ANTES do deploy. Ao contrário, as instâncias
# novas da função sobem contra um schema que ainda não existe. É a mesma
# regra do runbook do VPS — aqui ela vira ordem de job em vez de dois
# comandos digitados a mão.

name: Deploy

on:
  push:
    branches: [main]

jobs:
  migrar:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install -e ./api
      - name: Alembic upgrade head
        working-directory: api
        env:
          # A URL DIRETA, sem pooler — é a que o Alembic sempre usou, mesmo
          # no VPS. O secret é o mesmo endpoint do api/.env de produção.
          DATABASE_URL: ${{ secrets.DATABASE_URL_DIRETA }}
          DATABASE_URL_DIRETA: ${{ secrets.DATABASE_URL_DIRETA }}
        run: alembic upgrade head

  deploy:
    needs: migrar
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: npm install -g vercel
      - name: Deploy da API
        working-directory: api
        run: vercel deploy --prod --token=${{ secrets.VERCEL_TOKEN }} --yes
      - name: Deploy do front
        working-directory: web
        run: vercel deploy --prod --token=${{ secrets.VERCEL_TOKEN }} --yes
