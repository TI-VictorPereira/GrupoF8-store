# Copie para api/.env e preencha. O arquivo .env NÃO vai para o git.

AMBIENTE=desenvolvimento

# Neon — endpoint COM pooler (termina em -pooler). Usado pela aplicação.
DATABASE_URL=postgresql+psycopg://<USUARIO>:<SENHA>@<HOST>-pooler.<REGIAO>.aws.neon.tech/<BANCO>?sslmode=require

# Neon — endpoint DIRETO (sem -pooler). Usado só pelo Alembic.
DATABASE_URL_DIRETA=postgresql+psycopg://<USUARIO>:<SENHA>@<HOST>.<REGIAO>.aws.neon.tech/<BANCO>?sslmode=require

# Gere com: openssl rand -hex 32
JWT_SECRET=<SEGREDO>
ACESSO_EXPIRA_MINUTOS=30
REFRESH_EXPIRA_HORAS=12

# Em desenvolvimento (http://localhost) o cookie Secure não é enviado.
COOKIE_SEGURO=false
COOKIE_DOMINIO=

MAX_TENTATIVAS=5
BLOQUEIO_MINUTOS=2
SENHA_TAMANHO_MINIMO=8

ALMOCO_VALIDADE_MINUTOS=15
FUSO=America/Sao_Paulo

LOG_NIVEL=INFO
SENTRY_DSN=
